# Auto-updates run pnpm non-interactively — the menu-bar app spawns update.sh with no TTY.
# When pnpm decides node_modules must be rebuilt (e.g. Node/ABI drift), it otherwise aborts
# with ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY asking for confirmation, and the whole
# update rolls back — silently stranding everyone on an old build. Let the purge proceed.
confirm-modules-purge=false
