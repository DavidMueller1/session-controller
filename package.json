{
  "name": "traffic-controller",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Air-traffic-control style tracker for parallel Claude sessions",
  "scripts": {
    "start": "tsx src/server.ts",
    "serve": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "board": "tsx src/console-app.ts",
    "once": "tsx src/console-app.ts --once",
    "doctor": "tsx src/doctor.ts",
    "ui": "pnpm --dir web dev",
    "ui:build": "pnpm --dir web build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^8.0.4",
    "@fastify/websocket": "^11.0.2",
    "better-sqlite3": "^11.8.1",
    "chokidar": "^4.0.3",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  }
}
